---
 daemon/src/plamo_translated/protocol.py | 34 ++++++++++++++++++++++-
 daemon/tests/test_protocol.py           | 36 +++++++++++++++++++++++++
 2 files changed, 69 insertions(+), 1 deletion(-)

diff --git a/daemon/src/plamo_translated/protocol.py b/daemon/src/plamo_translated/protocol.py
index a4780ea..60b0b51 100644
--- a/daemon/src/plamo_translated/protocol.py
+++ b/daemon/src/plamo_translated/protocol.py
@@ -12,6 +12,12 @@ class GlossaryEntry:
     target: str
 
 
+@dataclass(frozen=True)
+class HistoryEntry:
+    source: str
+    translation: str
+
+
 @dataclass(frozen=True)
 class TranslateRequest:
     text: str
@@ -22,6 +28,7 @@ class TranslateRequest:
     form: str | None = None
     stream: bool = True
     max_tokens: int | None = None
+    history: tuple[HistoryEntry, ...] = ()
 
 
 @dataclass(frozen=True)
@@ -72,6 +79,22 @@ def _parse_glossary(raw) -> tuple[GlossaryEntry, ...]:
     return tuple(entries)
 
 
+def _parse_history(raw) -> tuple[HistoryEntry, ...]:
+    if raw is None:
+        return ()
+    if not isinstance(raw, list):
+        raise _invalid("field history must be an array")
+    entries = []
+    for item in raw:
+        if not isinstance(item, dict):
+            raise _invalid("history entries must be objects")
+        source, translation = item.get("source"), item.get("translation")
+        if not isinstance(source, str) or not isinstance(translation, str):
+            raise _invalid("history entries need string source and translation")
+        entries.append(HistoryEntry(source, translation))
+    return tuple(entries)
+
+
 def parse_request(line: bytes) -> TranslateRequest | StatusRequest | LoadRequest:
     if len(line) > MAX_LINE_BYTES:
         raise _invalid("request line exceeds 4 MiB")
@@ -112,6 +135,7 @@ def parse_request(line: bytes) -> TranslateRequest | StatusRequest | LoadRequest
         form=_str_field(obj, "form"),
         stream=stream,
         max_tokens=max_tokens,
+        history=_parse_history(obj.get("history")),
     )
 
 
@@ -135,10 +159,18 @@ def delta(text: str) -> dict:
     return _event("delta", text=text)
 
 
-def done(text: str, input_tokens: int, output_tokens: int, model: str, revision: str) -> dict:
+def done(
+    text: str,
+    input_tokens: int,
+    output_tokens: int,
+    model: str,
+    revision: str,
+    finish_reason: str | None = None,
+) -> dict:
     return _event(
         "done",
         text=text,
+        finish_reason=finish_reason,
         usage={"input_tokens": input_tokens, "output_tokens": output_tokens},
         model=model,
         revision=revision,
diff --git a/daemon/tests/test_protocol.py b/daemon/tests/test_protocol.py
index 6482222..93b1733 100644
--- a/daemon/tests/test_protocol.py
+++ b/daemon/tests/test_protocol.py
@@ -6,6 +6,7 @@ import pytest
 from plamo_translated.protocol import (
     DaemonError,
     GlossaryEntry,
+    HistoryEntry,
     LoadRequest,
     StatusRequest,
     TranslateRequest,
@@ -32,6 +33,41 @@ def test_parse_glossary_entries():
     assert r.glossary == (GlossaryEntry("推論", "inference"),)
 
 
+def test_parse_history_entries_in_order_ignoring_extra_keys():
+    r = parse_request('{"v":1,"op":"translate","text":"x","target_lang":"en","history":[{"source":"a","translation":"A","note":1},{"source":"b","translation":"B"}]}'.encode())
+    assert r.history == (HistoryEntry("a", "A"), HistoryEntry("b", "B"))
+
+
+@pytest.mark.parametrize("history", ["", ',"history":null', ',"history":[]'])
+def test_parse_absent_null_and_empty_history_are_equal(history):
+    line = f'{{"v":1,"op":"translate","text":"x","target_lang":"en"{history}}}'.encode()
+    assert parse_request(line) == TranslateRequest(text="x", target_lang="en")
+
+
+@pytest.mark.parametrize(("history", "message"), [
+    ('"x"', "field history must be an array"),
+    ('{"source":"a","translation":"A"}', "field history must be an array"),
+    ('["a"]', "history entries must be objects"),
+    ('[{"source":"a"}]', "history entries need string source and translation"),
+    ('[{"source":"a","translation":1}]', "history entries need string source and translation"),
+    ('[{"source":"a","target":"A"}]', "history entries need string source and translation"),
+])
+def test_parse_rejects_malformed_history(history, message):
+    with pytest.raises(DaemonError) as e:
+        parse_request(f'{{"v":1,"op":"translate","text":"x","target_lang":"en","history":{history}}}'.encode())
+    assert (e.value.code, e.value.message) == ("invalid_request", message)
+
+
+def test_parse_type_errors_precede_history_errors():
+    with pytest.raises(DaemonError) as e:
+        parse_request(b'{"v":1,"op":"translate","text":"x","target_lang":"en","form":1,"history":"x"}')
+    assert e.value.message == "field form must be a string"
+
+
+def test_done_carries_finish_reason_after_text():
+    assert list(done("t", 1, 2, "m", "r", finish_reason="stop")) == ["type", "text", "finish_reason", "usage", "model", "revision"]
+
+
 def test_parse_load():
     assert parse_request(b'{"v":1,"op":"load"}') == LoadRequest()
 
