 import pytest
 
+from plamo_translated.pfml3 import validate
 from plamo_translated.protocol import (
     DaemonError,
     GlossaryEntry,
@@ -139,11 +140,21 @@ def test_fixture_request_matches_expected_outcome(path):
     else:
         line = json.dumps(request, ensure_ascii=False).encode()
