index 61f003f..c9a3eb4 100644
--- a/daemon/tests/test_server.py
+++ b/daemon/tests/test_server.py
@@ -8,7 +8,7 @@ import pytest
 
 from conftest import FakeEngine
 from plamo_translated.engine import TextStream
-from plamo_translated.protocol import MAX_LINE_BYTES
+from plamo_translated.protocol import MAX_LINE_BYTES, HistoryEntry
 from plamo_translated.server import MAX_QUEUE, Server
 
 VERSION = "9.9.9"
@@ -424,10 +424,12 @@ async def test_status_reports_fields():
         "queue_len": 0,
         "version": VERSION,
         "protocol": 1,
+        "features": ["history"],
     }
     assert isinstance(ev["uptime_secs"], int) and ev["uptime_secs"] >= 0
     await roundtrip(path, LOAD)
-    assert (await status_of(path))["loaded"] is True
+    after = await status_of(path)
+    assert (after["loaded"], after["template_verified"]) == (True, True)
 
 
 async def test_validation_precedes_load():
@@ -491,3 +493,19 @@ async def test_engine_without_finish_reason_is_internal_error():
 
     ev = await roundtrip_with(NoReason(), translate(stream=False))
     assert (ev[-1]["type"], ev[-1]["code"]) == ("error", "internal")
+
+
+async def test_history_reaches_engine_unchanged_and_is_never_dropped():
+    engine = loaded(input_tokens=32000)
+    history = [{"source": " a\n", "translation": "A ", "x": 1}, {"source": "b", "translation": "B"}]
+    (ev,) = await roundtrip_with(engine, translate(history=history, max_tokens=1000))
+    assert ev["code"] == "context_too_long"
+    assert [r.history for r in engine.calls] == [(HistoryEntry(" a\n", "A "), HistoryEntry("b", "B"))]
+
+
+async def test_status_reports_unverified_template():
+    class Drifted(FakeEngine):
+        template_verified = False
+
+    _, path, _ = await run_server(Drifted())
+    assert (await status_of(path))["template_verified"] is False
diff --git a/protocol/fixtures/README.md b/protocol/fixtures/README.md
index f75ab59..8a7938f 100644
--- a/protocol/fixtures/README.md
+++ b/protocol/fixtures/README.md
@@ -11,7 +11,7 @@ Line layout:
 `fake` keys:
 
 - `tokens: [str]`: tokens the engine emits.
-- `input_tokens: int`: reported input token count.
+- `input_tokens: int`: reported input token count. It does not depend on the request, so `error_context_too_long_history.ndjson` shows only that a request with history reaches the token-budget check; that history counts toward the budget is tested by the daemon's server unit tests.
 - `load_error: str`: model load fails with this message.
 - `download: bool`: loading goes through a `downloading` progress phase.
 
@@ -20,3 +20,9 @@ The FakeEngine ends every uninterrupted generation with `finish_reason` `"stop"`
 The daemon test starts the FakeEngine with the model already loaded unless `download` or `load_error` is set, so only those scenarios include load `progress` events.
 
 Matching: the string `"<any>"` matches any value. Expected events are matched as a subset of the actual event's keys, except keys prefixed with `x_`, which only exist to exercise forward compatibility. Daemon tests ignore `x_` keys in expected events; client tests feed the lines verbatim and must ignore unknown keys.
+
+Event fields that fixtures assert where they matter:
+
+- `done.finish_reason` (`"stop"` | `"length"`): present on the `done` of a `translate` request, absent on the `done` of `load` (`translate_history.ndjson`, `load_with_download.ndjson`).
+- `status.features`: request-side capabilities; currently `["history"]` (`status.ndjson`).
+- `status.template_verified` (bool): whether the loaded snapshot's chat template is the one the daemon's PFML3 builder was verified against; omitted while the model is not loaded. Not asserted by fixtures.
